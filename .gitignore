# 4. Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Testing & Coverage
coverage/
*/coverage/
.nyc_output/
*.lcov

# 6. TypeScript Cache
*.tsbuildinfo
.turbo

# 7. IDE & Editor Files
