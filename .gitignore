node_modules/
*/node_modules/
.pnp
.pnp.js

# 2. Production & Build Outputs
dist/
*/dist/
build/
*/build/
out/
*/out/
.next/
*/.next/

# 3. Environment & Secret Files (Keep .env.example)
.env
.env*.local
.env.development
.env.test
.env.production
*/.env
*/.env*.local
*/.env.development
*/.env.test
*/.env.production
