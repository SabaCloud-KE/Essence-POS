datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  STAFF
}

enum SaleStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  MPESA
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  TIMEOUT
  REFUNDED
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  SECURITY
  PAYMENT
}

model User {
  id           Int        @id @default(autoincrement())
  uuid         String     @unique @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(STAFF)
  mfaEnabled   Boolean    @default(false)
  mfaSecret    String?
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  failedLogins       Int        @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sales        Sale[]
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role])
}

model Service {
  id              Int        @id @default(autoincrement())
  uuid            String     @unique @default(uuid())
  name            String
  description     String?    @db.Text
  category        String
  price           Decimal    @db.Decimal(10, 2)
  durationMinutes Int        @default(30)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  saleItems       SaleItem[]

  @@index([category])
  @@index([isActive])
}

model Sale {
  id            Int        @id @default(autoincrement())
  uuid          String     @unique @default(uuid())
  receiptNumber String     @unique
  userId        Int
  user          User       @relation(fields: [userId], references: [id])
  subtotal      Decimal    @db.Decimal(10, 2)
  discount      Decimal    @default(0.00) @db.Decimal(10, 2)
  totalAmount   Decimal    @db.Decimal(10, 2)
  status        SaleStatus @default(PENDING)
  customerName  String?
  customerPhone String
  notes         String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items         SaleItem[]
  payments      Payment[]

  @@index([receiptNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  saleId      Int
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id])
  serviceName String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(1)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([saleId])
  @@index([serviceId])
}

model Payment {
  id                 Int           @id @default(autoincrement())
  uuid               String        @unique @default(uuid())
  saleId             Int
  sale               Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  amount             Decimal       @db.Decimal(10, 2)
  phoneNumber        String
  paymentMethod      PaymentMethod @default(MPESA)
  status             PaymentStatus @default(PENDING)
  merchantRequestId  String?
  checkoutRequestId  String?       @unique
  mpesaReceiptNumber String?       @unique
  resultCode         Int?
  resultDescription  String?       @db.Text
  transactionDate    DateTime?
  rawCallbackPayload String?       @db.LongText
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([saleId])
  @@index([checkoutRequestId])
  @@index([mpesaReceiptNumber])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  description String   @db.Text
  ipAddress   String?
  userAgent   String?  @db.Text
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model SystemLog {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  level      LogLevel @default(INFO)
  context    String
  message    String   @db.Text
  stackTrace String?  @db.Text
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([context])
  @@index([createdAt])
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([key])
}
