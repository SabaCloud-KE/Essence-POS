# ==========================================
# Essence Hair & Beauty Salon POS Environment Variables
# ==========================================

# Database connection (MySQL / MariaDB)
DATABASE_URL="mysql://root:@localhost:3306/essence_pos_db"

# Server Port & Allowed Origins
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Security & JWT Tokens
JWT_SECRET=replace_with_a_secure_random_64_char_string
JWT_EXPIRES_IN=8h
MFA_ENCRYPTION_KEY=replace_with_a_secure_32_char_key

# Safaricom Daraja M-Pesa API
# Environment: 'sandbox' or 'production'
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_daraja_online_passkey
MPESA_CALLBACK_URL=https://your-domain-or-tunnel.ngrok-free.app/api/payments/mpesa/callback

# Salon Branding Information
SALON_NAME="Essence Hair & Beauty Salon"
SALON_LOCATION="Nairobi, Kenya"
SALON_PHONE="+254 700 123 456"
SALON_EMAIL="info@essence.co.ke"

# Next.js Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
